# Exact matching fallbacks for compiler- and MMIO-sensitive overlay 47 code.

build build/decomp/asm/overlays/ov047/overlay047_controller_construct.o: mwasmarm asm/overlays/ov047/overlay047_controller_construct.s
build build/decomp/delinks/asm/overlays/ov047/overlay047_controller_construct.o: dsd_delink config/arm9/config.yaml | config/arm9/overlays/ov047/delinks.txt config/arm9/overlays/ov047/symbols.txt config/arm9/overlays/ov047/relocs.txt
  object = asm/overlays/ov047/overlay047_controller_construct.s
build build/reports/overlay047_controller_construct.json: objdiff build/decomp/asm/overlays/ov047/overlay047_controller_construct.o build/decomp/delinks/asm/overlays/ov047/overlay047_controller_construct.o
  target_object = build/decomp/asm/overlays/ov047/overlay047_controller_construct.o
  base_object = build/decomp/delinks/asm/overlays/ov047/overlay047_controller_construct.o
build build/reports/overlay047_controller_construct.txt: match_report build/reports/overlay047_controller_construct.json | tools/report_objdiff.py
  report_json = build/reports/overlay047_controller_construct.json
  report_args = --section .text --function func_ov047_0220b740 --require-exact

