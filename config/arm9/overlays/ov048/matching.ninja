# Exact matching fallbacks for volatile-MMIO overlay 48 routines.

build build/decomp/asm/overlays/ov048/overlay048_display_setup.o: mwasmarm asm/overlays/ov048/overlay048_display_setup.s
build build/decomp/delinks/asm/overlays/ov048/overlay048_display_setup.o: dsd_delink config/arm9/config.yaml | config/arm9/overlays/ov048/delinks.txt config/arm9/overlays/ov048/symbols.txt config/arm9/overlays/ov048/relocs.txt
  object = asm/overlays/ov048/overlay048_display_setup.s
build build/reports/overlay048_display_setup.json: objdiff build/decomp/asm/overlays/ov048/overlay048_display_setup.o build/decomp/delinks/asm/overlays/ov048/overlay048_display_setup.o
  target_object = build/decomp/asm/overlays/ov048/overlay048_display_setup.o
  base_object = build/decomp/delinks/asm/overlays/ov048/overlay048_display_setup.o
build build/reports/overlay048_display_setup.txt: match_report build/reports/overlay048_display_setup.json | tools/report_objdiff.py
  report_json = build/reports/overlay048_display_setup.json
  report_args = --section .text --function func_ov048_0220b7b8 --require-exact

