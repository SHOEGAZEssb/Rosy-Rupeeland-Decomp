include build/config.ninja

mt_cflags = -proc arm946e -O4 -inline on,noauto -ipa file -interworking -Cpp_exceptions off -lang c
input_cflags = -proc arm946e -O3 -inline on,noauto -ipa file -interworking -DMATCHING -lang c
debug_menu_cflags = -proc arm946e -O4 -inline off -ipa function -interworking -lang c++
game_work_cflags = -proc arm946e -O4 -inline off -ipa file -interworking -Cpp_exceptions off -DMATCHING -lang c
game_flags_cflags = -proc arm946e -O4 -inline off -ipa file -interworking -Cpp_exceptions off -lang c
game_work_io_cflags = -proc arm946e -O4 -inline off -ipa file -interworking -Cpp_exceptions off -lang c
game_phase_cflags = -proc arm946e -O4 -inline off -ipa function -interworking -lang c++
scene_cflags = -proc arm946e -O4 -inline off -ipa function -interworking -DMATCHING -lang c++
scene_touch_cflags = -proc arm946e -O4 -inline off -ipa function -interworking -DMATCHING -lang c++
touch_panel_cflags = -proc arm946e -O4 -inline off -ipa function -interworking -DMATCHING -lang c++
frame_task_cflags = -proc arm946e -O4 -inline off -ipa function -interworking -DMATCHING -lang c++
graphics_system_cflags = -proc arm946e -O4 -inline off -ipa function -interworking -DMATCHING -lang c++
palette_buffer_cflags = -proc arm946e -O4 -inline off -ipa function -interworking -DMATCHING -lang c++
thread_cflags = -proc arm946e -O4 -inline off -ipa function -interworking -DMATCHING -lang c++
bg_scroll_cflags = -proc arm946e -O4 -inline off -ipa function -interworking -DMATCHING -lang c++
graphics_resources_cflags = -proc arm946e -O4 -inline off -ipa function -interworking -DMATCHING -lang c++
graphics_display_cflags = -proc arm946e -O4 -inline off -ipa function -interworking -DMATCHING -lang c++
error_display_cflags = -proc arm946e -O4 -inline off -ipa function -interworking -Cpp_exceptions off -DMATCHING -lang c++
checked_fs_cflags = -proc arm946e -O4 -inline off -ipa function -interworking -Cpp_exceptions off -DMATCHING -lang c++
game_string_cflags = -proc arm946e -O4 -inline off -ipa function -interworking -Cpp_exceptions off -DMATCHING -lang c++
game_file_cflags = -proc arm946e -O4 -inline off -ipa function -interworking -Cpp_exceptions off -DMATCHING -lang c++
touch_region_cflags = -proc arm946e -O4 -inline off -ipa function -interworking -Cpp_exceptions off -DMATCHING -lang c++

rule mwccarm
  command = "$mwccarm" $cflags -i "$repo_root/include" -c $source -o $out
  description = MWCCARM $source

rule mwasmarm
  command = "$mwasmarm" -proc arm5TE -c $in -o $out
  description = MWASMARM $in

rule mwldarm_partial
  command = "$mwldarm" -partial -nostdlib -nodeadstrip $in -o $out
  description = MWLDARM PARTIAL $out

rule mwldarm_archive
  command = "$mwldarm" -library $in -o $out
  description = MWLDARM $out

rule dsd_delink
  command = "$dsd" delink --config-path config/arm9/config.yaml
  description = DSD DELINK
  restat = 1

rule dsd_lcf
  command = "$dsd" lcf --config-path config/arm9/config.yaml
  description = DSD LCF
  restat = 1

rule prepare_link_objects
  command = powershell -NoProfile -ExecutionPolicy Bypass -File tools/prepare_link_objects.ps1 -InputPath build/decomp/objects.txt -ReplacementsPath config/arm9/link_replacements.txt -OutputPath $out
  description = LINK OBJECTS $out

rule mwldarm_link
  command = "$mwldarm" -proc arm946e -nostdlib -nodeadstrip -interworking -main Entry -map -o build/decomp/tingle.elf @build/decomp/objects.source.txt build/decomp/arm9.lcf
  description = MWLDARM ROM MODULES

rule build_recompiled_rom
  command = powershell -NoProfile -ExecutionPolicy Bypass -File tools/build_recompiled_rom.ps1 -DsdExe "$dsd" -PythonExe "$python" -OutputRom $out
  description = ROM $out

rule extract_slice
  command = "$python" tools/extract_slice.py $in $out --base-address 0x02000000 --start $slice_start --end $slice_end --sha256 $slice_sha256
  description = EXTRACT $out

rule objdiff
  command = "$objdiff" --no-color diff -1 $target_object -2 $base_object -o $out --format json
  description = OBJD_DIFF $out

rule match_report
  command = "$python" tools/report_objdiff.py $report_json $out $report_args
  description = MATCH $out

build build/decomp/delinks/src/system/mt19937.o | build/decomp/delinks/src/system/input.o build/decomp/delinks/src/system/debug_menu.o build/decomp/delinks/src/system/game_work.o build/decomp/delinks/src/system/frame_task_list.o build/decomp/delinks/src/system/game_flags.o build/decomp/delinks/src/system/game_work_io.o build/decomp/delinks/src/system/game_phase.o build/decomp/delinks/src/system/scene_touch_data.o build/decomp/delinks/src/system/scene.o build/decomp/delinks/src/system/scene_touch.o build/decomp/delinks/src/system/touch_panel.o build/decomp/delinks/src/system/graphics_system.o build/decomp/delinks/src/system/frame_task.o build/decomp/delinks/src/system/frame_task_tags.o build/decomp/delinks/src/system/palette_buffer.o build/decomp/delinks/asm/system/palette_buffer_data.o build/decomp/delinks/src/system/thread.o build/decomp/delinks/asm/system/thread_data.o build/decomp/delinks/src/system/bg_scroll.o build/decomp/delinks/src/system/graphics_resources.o build/decomp/delinks/src/system/graphics_display.o build/decomp/delinks/src/system/error_display.o build/decomp/delinks/src/system/checked_fs.o build/decomp/delinks/src/system/game_string.o build/decomp/delinks/src/system/game_file.o build/decomp/delinks/src/system/touch_region.o: dsd_delink config/arm9/config.yaml config/arm9/delinks.txt config/arm9/symbols.txt config/arm9/relocs.txt | build/rom/arm9/arm9.bin

build build/decomp/src/system/mt19937.o: mwccarm src/system/mt19937.c | include/tingle/random.h include/tingle/types.h
  source = src/system/mt19937.c
  cflags = $mt_cflags

build build/decomp/src/system/input_c.o: mwccarm src/system/input.c | include/tingle/system.h include/tingle/types.h
  source = src/system/input.c
  cflags = $input_cflags

build build/decomp/src/system/input_update.o: mwasmarm asm/system/input_update.s

build build/decomp/src/system/input.o: mwldarm_partial build/decomp/src/system/input_c.o build/decomp/src/system/input_update.o

build build/decomp/src/system/debug_menu.o: mwccarm src/system/debug_menu.c | include/tingle/debug_menu.h include/tingle/types.h
