include build/config.ninja

mt_cflags = -proc arm946e -O4 -inline on,noauto -ipa file -interworking -Cpp_exceptions off -lang c
input_cflags = -proc arm946e -O3 -inline on,noauto -ipa file -interworking -DMATCHING -lang c
debug_menu_cflags = -proc arm946e -O4 -inline off -ipa function -interworking -lang c++
game_work_cflags = -proc arm946e -O4 -inline off -ipa file -interworking -Cpp_exceptions off -DMATCHING -lang c
game_flags_cflags = -proc arm946e -O4 -inline off -ipa file -interworking -Cpp_exceptions off -lang c
game_work_io_cflags = -proc arm946e -O4 -inline off -ipa file -interworking -Cpp_exceptions off -lang c
game_phase_cflags = -proc arm946e -O4 -inline off -ipa function -interworking -lang c++

rule mwccarm
  command = "$mwccarm" $cflags -i "$repo_root/include" -c $source -o $out
  description = MWCCARM $source

rule mwasmarm
  command = "$mwasmarm" -proc arm5TE -c $in -o $out
  description = MWASMARM $in

rule mwldarm_partial
  command = "$mwldarm" -partial -nostdlib -nodeadstrip $in -o $out
  description = MWLDARM PARTIAL $out

rule mwldarm_archive
  command = "$mwldarm" -library $in -o $out
  description = MWLDARM $out

rule dsd_delink
  command = "$dsd" delink --config-path config/arm9/config.yaml
  description = DSD DELINK
  restat = 1

rule dsd_lcf
  command = "$dsd" lcf --config-path config/arm9/config.yaml
  description = DSD LCF
  restat = 1

rule prepare_link_objects
  command = powershell -NoProfile -ExecutionPolicy Bypass -File tools/prepare_link_objects.ps1 -InputPath build/decomp/objects.txt -ReplacementsPath config/arm9/link_replacements.txt -OutputPath $out
  description = LINK OBJECTS $out

rule mwldarm_link
  command = "$mwldarm" -proc arm946e -nostdlib -nodeadstrip -interworking -main Entry -map -o build/decomp/tingle.elf @build/decomp/objects.source.txt build/decomp/arm9.lcf
  description = MWLDARM ROM MODULES

rule build_recompiled_rom
  command = powershell -NoProfile -ExecutionPolicy Bypass -File tools/build_recompiled_rom.ps1 -DsdExe "$dsd" -PythonExe "$python" -OutputRom $out
  description = ROM $out

rule extract_slice
  command = "$python" tools/extract_slice.py $in $out --base-address 0x02000000 --start $slice_start --end $slice_end --sha256 $slice_sha256
  description = EXTRACT $out

rule objdiff
  command = "$objdiff" --no-color diff -1 $target_object -2 $base_object -o $out --format json
  description = OBJD_DIFF $out

rule match_report
  command = "$python" tools/report_objdiff.py $report_json $out $report_args
  description = MATCH $out

build build/decomp/delinks/src/system/mt19937.o | build/decomp/delinks/src/system/input.o build/decomp/delinks/src/system/debug_menu.o build/decomp/delinks/src/system/game_work.o build/decomp/delinks/src/system/game_flags.o build/decomp/delinks/src/system/game_work_io.o build/decomp/delinks/src/system/game_phase.o: dsd_delink config/arm9/config.yaml config/arm9/delinks.txt config/arm9/symbols.txt config/arm9/relocs.txt | build/rom/arm9/arm9.bin

build build/decomp/src/system/mt19937.o: mwccarm src/system/mt19937.c | include/tingle/random.h include/tingle/types.h
  source = src/system/mt19937.c
  cflags = $mt_cflags

build build/decomp/src/system/input_c.o: mwccarm src/system/input.c | include/tingle/system.h include/tingle/types.h
  source = src/system/input.c
  cflags = $input_cflags

build build/decomp/src/system/input_update.o: mwasmarm asm/system/input_update.s

build build/decomp/src/system/input.o: mwldarm_partial build/decomp/src/system/input_c.o build/decomp/src/system/input_update.o

build build/decomp/src/system/debug_menu.o: mwccarm src/system/debug_menu.c | include/tingle/debug_menu.h include/tingle/types.h
  source = src/system/debug_menu.c
  cflags = $debug_menu_cflags

build build/decomp/src/system/game_work.o: mwccarm src/system/game_work.c | include/tingle/game_work.h include/tingle/types.h
  source = src/system/game_work.c
  cflags = $game_work_cflags

build build/decomp/src/system/game_flags.o: mwccarm src/system/game_flags.c | include/tingle/game_work.h include/tingle/types.h
  source = src/system/game_flags.c
  cflags = $game_flags_cflags

build build/decomp/src/system/game_work_io.o: mwccarm src/system/game_work_io.c | include/tingle/game_work.h include/tingle/types.h
  source = src/system/game_work_io.c
  cflags = $game_work_io_cflags

build build/decomp/src/system/game_phase.o: mwccarm src/system/game_phase.c | include/tingle/game_phase.h include/tingle/game_work.h include/tingle/types.h
  source = src/system/game_phase.c
  cflags = $game_phase_cflags

build build/decomp/lib/tingle.a: mwldarm_archive build/decomp/src/system/mt19937.o build/decomp/src/system/input.o build/decomp/src/system/debug_menu.o build/decomp/src/system/game_work.o build/decomp/src/system/game_flags.o build/decomp/src/system/game_work_io.o build/decomp/src/system/game_phase.o

build build/decomp/arm9.lcf build/decomp/objects.txt: dsd_lcf config/arm9/config.yaml config/arm9/delinks.txt config/arm9/symbols.txt config/arm9/relocs.txt | build/decomp/delinks/src/system/mt19937.o

build build/decomp/objects.source.txt: prepare_link_objects build/decomp/objects.txt config/arm9/link_replacements.txt tools/prepare_link_objects.ps1 | build/decomp/src/system/mt19937.o build/decomp/src/system/input.o build/decomp/src/system/debug_menu.o build/decomp/src/system/game_work.o build/decomp/src/system/game_flags.o build/decomp/src/system/game_work_io.o build/decomp/src/system/game_phase.o

build build/decomp/tingle.elf | build/decomp/build/arm9.bin build/decomp/build/itcm.bin build/decomp/build/dtcm.bin: mwldarm_link build/decomp/objects.source.txt build/decomp/arm9.lcf | build/decomp/src/system/mt19937.o build/decomp/src/system/input.o build/decomp/src/system/debug_menu.o build/decomp/src/system/game_work.o build/decomp/src/system/game_flags.o build/decomp/src/system/game_work_io.o build/decomp/src/system/game_phase.o

build build/tingle.recompiled.nds: build_recompiled_rom build/decomp/tingle.elf | tools/build_recompiled_rom.ps1 tools/patch_rom_header.py

build build/reference/mt19937.text.bin: extract_slice build/rom/arm9/arm9.bin
  slice_start = 0x0200234c
  slice_end = 0x02002638
  slice_sha256 = BB847ACB31A6B5F24FEAC97F6DE603E640B0BD4ED1C5810881D0FF3B0690C490

build build/reference/init_genrand.bin: extract_slice build/rom/arm9/arm9.bin
  slice_start = 0x0200234c
  slice_end = 0x020023a0
  slice_sha256 = 5C0F6F4135F440181ECA364E2767AD999F348155291FC3E49546D88820ACDF9D

build build/reference/init_by_array.bin: extract_slice build/rom/arm9/arm9.bin
  slice_start = 0x020023a0
  slice_end = 0x020024b0
  slice_sha256 = 5F441DF5770B57B1E589A228BEF01463349A6C21FA3EF81530FEFB44A9569068

build build/reference/genrand_int32.bin: extract_slice build/rom/arm9/arm9.bin
  slice_start = 0x020024b0
  slice_end = 0x02002608
  slice_sha256 = DA52559E9777E8639125D2EA663B661063731F840D0949496B96D50BF015BF29

build build/reference/InitRandom.bin: extract_slice build/rom/arm9/arm9.bin
  slice_start = 0x02002608
  slice_end = 0x02002638
  slice_sha256 = CA31A898643247A18E9478E592C819FE0446BF3B063F30211BB93DA7CDFF17E5

build build/reports/mt19937.json: objdiff build/decomp/delinks/src/system/mt19937.o | build/decomp/src/system/mt19937.o
  target_object = build/decomp/delinks/src/system/mt19937.o
  base_object = build/decomp/src/system/mt19937.o

build build/reports/mt19937.txt: match_report build/reports/mt19937.json | tools/report_objdiff.py
  report_json = build/reports/mt19937.json
  report_args = --require-exact

build build/reports/input.json: objdiff build/decomp/delinks/src/system/input.o | build/decomp/src/system/input.o
  target_object = build/decomp/delinks/src/system/input.o
  base_object = build/decomp/src/system/input.o

build build/reports/input.txt: match_report build/reports/input.json | tools/report_objdiff.py
  report_json = build/reports/input.json
  report_args = --section .text --function PAD_Read --function UpdateSystemFrame --function UpdateKeyState

build build/reports/debug_menu.json: objdiff build/decomp/delinks/src/system/debug_menu.o | build/decomp/src/system/debug_menu.o
  target_object = build/decomp/delinks/src/system/debug_menu.o
  base_object = build/decomp/src/system/debug_menu.o

build build/reports/debug_menu.txt: match_report build/reports/debug_menu.json | tools/report_objdiff.py
  report_json = build/reports/debug_menu.json
  report_args = --section .text --section .data --function DebugMenu_Init --function DebugMenu_Destroy --function DebugMenu_DestroyAndFree --function DebugMenu_Update --function DebugMenu_Create

build build/reports/debug_menu_exact.txt: match_report build/reports/debug_menu.json | tools/report_objdiff.py
  report_json = build/reports/debug_menu.json
  report_args = --section .text --section .data --function DebugMenu_Init --function DebugMenu_Destroy --function DebugMenu_DestroyAndFree --function DebugMenu_Update --function DebugMenu_Create --require-exact

build build/reports/game_work.json: objdiff build/decomp/delinks/src/system/game_work.o | build/decomp/src/system/game_work.o
  target_object = build/decomp/delinks/src/system/game_work.o
  base_object = build/decomp/src/system/game_work.o

build build/reports/game_work.txt: match_report build/reports/game_work.json | tools/report_objdiff.py
  report_json = build/reports/game_work.json
  report_args = --section .text --section .data --section .bss --function GameWork_Create --function GameWork_Reset --function GameWork_Init --function GameWork_ClearPointerBank

build build/reports/game_flags.json: objdiff build/decomp/delinks/src/system/game_flags.o | build/decomp/src/system/game_flags.o
  target_object = build/decomp/delinks/src/system/game_flags.o
  base_object = build/decomp/src/system/game_flags.o

build build/reports/game_flags.txt: match_report build/reports/game_flags.json | tools/report_objdiff.py
  report_json = build/reports/game_flags.json
  report_args = --section .text --function GameWork_SetFlag --function GameWork_TestFlag --function GameWork_ClearFlag --require-exact

build build/reports/game_work_io.json: objdiff build/decomp/delinks/src/system/game_work_io.o | build/decomp/src/system/game_work_io.o
  target_object = build/decomp/delinks/src/system/game_work_io.o
  base_object = build/decomp/src/system/game_work_io.o

build build/reports/game_work_io.txt: match_report build/reports/game_work_io.json | tools/report_objdiff.py
  report_json = build/reports/game_work_io.json
  report_args = --section .text --section .data --function GameWork_Serialize --function GameWork_Deserialize --function GameWork_CompressionRoundTrip --require-exact

build build/reports/game_phase.json: objdiff build/decomp/delinks/src/system/game_phase.o | build/decomp/src/system/game_phase.o
  target_object = build/decomp/delinks/src/system/game_phase.o
  base_object = build/decomp/src/system/game_phase.o

build build/reports/game_phase.txt: match_report build/reports/game_phase.json | tools/report_objdiff.py
  report_json = build/reports/game_phase.json
  report_args = --section .text --section .data --function GamePhase_Start --function GamePhase_Bootstrap --function GamePhaseTransition_Init --function GamePhaseTransition_Destroy --function GamePhaseTransition_DestroyAndFree --function GamePhaseTransition_Update

build mt19937: phony build/decomp/delinks/src/system/mt19937.o build/decomp/src/system/mt19937.o
build input: phony build/decomp/delinks/src/system/input.o build/decomp/src/system/input.o build/reports/input.txt
build debug_menu: phony build/decomp/delinks/src/system/debug_menu.o build/decomp/src/system/debug_menu.o build/reports/debug_menu.txt build/reports/debug_menu_exact.txt
build game_work: phony build/decomp/delinks/src/system/game_work.o build/decomp/src/system/game_work.o build/reports/game_work.txt
build game_flags: phony build/decomp/delinks/src/system/game_flags.o build/decomp/src/system/game_flags.o build/reports/game_flags.txt
build game_work_io: phony build/decomp/delinks/src/system/game_work_io.o build/decomp/src/system/game_work_io.o build/reports/game_work_io.txt
build game_phase: phony build/decomp/delinks/src/system/game_phase.o build/decomp/src/system/game_phase.o build/reports/game_phase.txt
build archive: phony build/decomp/lib/tingle.a
build references: phony build/reference/mt19937.text.bin build/reference/init_genrand.bin build/reference/init_by_array.bin build/reference/genrand_int32.bin build/reference/InitRandom.bin
build match: phony build/reports/mt19937.txt build/reports/input.txt build/reports/debug_menu.txt build/reports/debug_menu_exact.txt build/reports/game_work.txt build/reports/game_flags.txt build/reports/game_work_io.txt build/reports/game_phase.txt build/decomp/lib/tingle.a references
build rom: phony build/tingle.recompiled.nds

default match
