rule mwccarm
  command = "$mwccarm" $cflags -i "$repo_root/include" -c $source -o $out
  description = MWCCARM $source

rule mwasmarm
  command = "$mwasmarm" -proc arm5TE -c $in -o $out
  description = MWASMARM $in

rule mwldarm_partial
  command = "$mwldarm" -partial -nostdlib -nodeadstrip $in -o $out
  description = MWLDARM PARTIAL $out

rule mwldarm_archive
  command = "$mwldarm" -library $in -o $out
  description = MWLDARM $out

rule dsd_delink
  command = "$dsd" delink --config-path config/arm9/config.yaml
  description = DSD DELINK
  restat = 1

rule dsd_lcf
  command = "$dsd" lcf --config-path config/arm9/config.yaml
  description = DSD LCF
  restat = 1

rule prepare_link_objects
  command = powershell -NoProfile -ExecutionPolicy Bypass -File tools/prepare_link_objects.ps1 -InputPath build/decomp/objects.txt -ReplacementsPath config/arm9/link_replacements.txt -OutputPath $out
  description = LINK OBJECTS $out

rule mwldarm_link
  command = "$mwldarm" -proc arm946e -nostdlib -nodeadstrip -interworking -main Entry -map -o build/decomp/tingle.elf @build/decomp/objects.source.txt build/decomp/arm9.lcf
  description = MWLDARM ROM MODULES

rule build_recompiled_rom
  command = powershell -NoProfile -ExecutionPolicy Bypass -File tools/build_recompiled_rom.ps1 -DsdExe "$dsd" -PythonExe "$python" -OutputRom $out
  description = ROM $out

rule extract_slice
  command = "$python" tools/extract_slice.py $in $out --base-address 0x02000000 --start $slice_start --end $slice_end --sha256 $slice_sha256
  description = EXTRACT $out

rule objdiff
  command = "$objdiff" --no-color diff -1 $target_object -2 $base_object -o $out --format json
  description = OBJD_DIFF $out

rule match_report
  command = "$python" tools/report_objdiff.py $report_json $out $report_args
  description = MATCH $out

